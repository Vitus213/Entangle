# Application Configuration
APP_NAME=Entangle
APP_ENV=development
APP_PORT=3000
APP_HOST=127.0.0.1

# Security
APP_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-characters-long

# Database Configuration (openGauss / PostgreSQL)
# Default openGauss credentials: user=omm, db=postgres
DATABASE_URL=postgres://omm:Entangle@2024@localhost:5432/postgres
DATABASE_MAX_CONNECTIONS=10

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=10

# JWT Configuration
JWT_SECRET=change-this-to-a-random-jwt-secret-key
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE=10485760

# Optional: S3 Storage
# STORAGE_TYPE=s3
# S3_BUCKET=entangle-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Email Configuration (Optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=
# SMTP_FROM=Entangle <noreply@example.com>

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty
RUST_LOG=entangle_api=debug,tower_http=debug

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_CLIENT_TIMEOUT=60
